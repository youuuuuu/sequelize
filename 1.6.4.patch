+    let isParanoid = false;
+    let deletedAtColumnName = 'deletedAt';
+
+    if (typeof tableName === 'function' && tableName.modelDefinition) {
+      // 如果 tableName 是模型类
+      modelDef = tableName.modelDefinition;
